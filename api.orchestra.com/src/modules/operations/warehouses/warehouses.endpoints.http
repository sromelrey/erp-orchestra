### Login (Establish Session) to get credentials if needed,
### or rely on browser cookies if using an extension
POST {{API_BASE_URL}}/v1/auth/login
Content-Type: application/json

{
    "email": "{{TEST_USERNAME}}",
    "password": "{{TEST_USER_PASSWORD}}"
}

### Create Warehouse
POST {{API_BASE_URL}}/v1/ops/warehouses
Content-Type: application/json

{
  "code": "WH-CEB",
  "name": "Liloan Head Quarter",
  "description": "Primary T-shirt printing warehouse",
  "isDefault": true
}

### List Warehouses
GET {{API_BASE_URL}}/v1/ops/warehouses

### Get Single Warehouse
GET {{API_BASE_URL}}/v1/ops/warehouses/1

### Get Warehouse Capacity
GET {{API_BASE_URL}}/v1/ops/warehouses/1/capacity

### Get Warehouse Locations
GET {{API_BASE_URL}}/v1/ops/warehouses/1/locations

### Get Warehouse Location Tree
GET {{API_BASE_URL}}/v1/ops/warehouses/1/locations/tree


### Update Warehouse
PATCH {{API_BASE_URL}}/v1/ops/warehouses/1
Content-Type: application/json

{
  "name": "Cebu Fulfillment Hub",
  "description": "Updated name for primary warehouse"
}

### Create Warehouse Location
POST {{API_BASE_URL}}/v1/ops/warehouses/1/locations
Content-Type: application/json

{
  "code": "PICK-PACK",
  "name": "Picking & Packing Area",
  "isActive": true
}

### List Locations for Warehouse
GET {{API_BASE_URL}}/v1/ops/warehouses/1/locations


### Record Stock Receipt
### Use to log inbound quantities (signed positive) and update balances
POST {{API_BASE_URL}}/v1/ops/stock-ledger
Content-Type: application/json

{
  "warehouseId": 1,
  "locationId": 1,
  "itemId": 1,
  "uomId": 1,
  "quantity": 250,
  "movementType": "RECEIPT",
  "referenceType": "PO",
  "referenceCode": "PO-2026-00045",
  "memo": "Fabric rolls received",
  "documentDate": "2026-03-16T06:30:00Z"
}

### List Stock Ledger Entries
### Use to review movement history (ordered by document date / id)
GET {{API_BASE_URL}}/v1/ops/stock-ledger

