
### Login (Establish Session) to get credentials if needed,
### or rely on browser cookies if using an extension
POST {{API_BASE_URL}}/v1/auth/login
Content-Type: application/json

{
    "email": "{{TEST_USERNAME}}",
    "password": "{{TEST_USER_PASSWORD}}"
}

### Create Item Category
### Use to define logical grouping for items (e.g., fabrics, trims)
POST {{API_BASE_URL}}/v1/ops/item-categories
Content-Type: application/json

{
  "code": "FAB",
  "name": "Fabric Rolls",
  "description": "Greige and dyed fabrics"
}


POST {{API_BASE_URL}}/v1/ops/item-categories
Content-Type: application/json

{
  "code": "CLOTHING",
  "name": "Clothing Items",
  "description": "Apparel and accessories"
}
### List Item Categories
### Use to confirm categories exist before linking them to items
GET {{API_BASE_URL}}/v1/ops/item-categories


### Update Item Category
### Use to rename or adjust description of an existing category
PATCH {{API_BASE_URL}}/v1/ops/item-categories/1
Content-Type: application/json

{
  "name": "Premium Fabric Rolls",
  "description": "Updated description"
}

### Create Unit of Measure
### Use to register a base or transactional UoM (precision controls decimals)
POST {{API_BASE_URL}}/v1/ops/item-uoms
Content-Type: application/json

{
  "code": "MTR",
  "name": "Meter",
  "precision": 2
}


POST {{API_BASE_URL}}/v1/ops/item-uoms
Content-Type: application/json

{
  "code": "PCS",
  "name": "Pieces",
  "precision": 0
}
### List Units of Measure
### Use to retrieve available UoMs before assigning to items
### Retrieves a list of all existing units of measure
GET {{API_BASE_URL}}/v1/ops/item-uoms


### Update Unit of Measure
### Use to adjust UoM display name or precision
### Updates the details of a specific unit of measure
PATCH {{API_BASE_URL}}/v1/ops/item-uoms/1
Content-Type: application/json

{
  "name": "Meter (m)",
  "precision": 3
}

### Create Item
### Use to register a sellable/stocked item; link to category and base UoM
POST {{API_BASE_URL}}/v1/ops/items
Content-Type: application/json

{
  "code": "TSHIRT-WHT-001",
  "name": "Basic White Tee",
  "description": "Crew neck, 180gsm cotton",
  "categoryId": 1,
  "baseUomId": 1,
  "isActive": true
}

POST {{API_BASE_URL}}/v1/ops/items
Content-Type: application/json
 
{
  "code": "ITEM001",
  "name": "Test Item 1",
  "description": "First test item",
  "baseUomId": 1,
  "categoryId": 1,
  "isActive": true
}
 
POST {{API_BASE_URL}}/v1/ops/items
Content-Type: application/json
 
{
  "code": "ITEM002",
  "name": "Test Item 2",
  "description": "Second test item",
  "baseUomId": 1,
  "categoryId": 1,
  "isActive": true
}

### List Items
### Use to verify created items and their relations (category, baseUom)
GET {{API_BASE_URL}}/v1/ops/items


### Update Item
### Use to change description/flags; keeps same category/UoM unless provided
PATCH {{API_BASE_URL}}/v1/ops/items/1
Content-Type: application/json

{
  "description": "Updated fabric blend",
  "isActive": true
}
