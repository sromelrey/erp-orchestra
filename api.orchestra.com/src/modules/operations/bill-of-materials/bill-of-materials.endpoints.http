### Login (Establish Session) to get credentials if needed,
### or rely on browser cookies if using an extension
POST {{API_BASE_URL}}/v1/auth/login
Content-Type: application/json

{
    "email": "{{TEST_USERNAME}}",
    "password": "{{TEST_USER_PASSWORD}}"
}

### Create BOM
POST {{API_BASE_URL}}/v1/ops/bom
Content-Type: application/json
{
  "code": "BOM-TSHIRT-004",
  "name": "Another T-Shirt BOM",
  "parentMaterialId": 2,
  "version": "4.0", 
  "lines": [
    {
      "componentMaterialId": 1,
      "quantity": 2,
      "uom": "MTR"
    }
  ]
}

### List BOMs
GET {{API_BASE_URL}}/v1/ops/bom?limit=20

### Search BOMs
GET {{API_BASE_URL}}/v1/ops/bom?search=TSHIRT&limit=20

### Get BOM by ID
GET {{API_BASE_URL}}/v1/ops/bom/7

### Update BOM (creates new version)
PATCH {{API_BASE_URL}}/v1/ops/bom/7
Content-Type: application/json

{
  "name": "T-Shirt Assembly v3",
  "version": "3.0",
  "lines": [
    {
      "componentMaterialId": 2,
      "quantity": 1.6,
      "uom": "MTR",
      "scrapPercentage": 3,
      "sortOrder": 1
    }
  ]
}

### Update BOM Status
PATCH {{API_BASE_URL}}/v1/ops/bom/7/status
Content-Type: application/json

{
  "status": "ACTIVE",
  "isActive": true
}

### Deactivate BOM
POST {{API_BASE_URL}}/v1/ops/bom/7/deactivate
Content-Type: application/json

{
  "isActive": true
}
### Get active BOM for item
GET {{API_BASE_URL}}/v1/ops/bom/item/7/active

### Calculate BOM cost
GET {{API_BASE_URL}}/v1/ops/bom/7/cost

### Get BOM cost breakdown (includes scrap, component detail)
GET {{API_BASE_URL}}/v1/ops/bom/7/cost/breakdown

### Get where used (implosion)
GET {{API_BASE_URL}}/v1/ops/bom/component/7/where-used

### Delete BOM
DELETE {{API_BASE_URL}}/v1/ops/bom/7
 
### Test Cycle Detection (should fail)
POST {{API_BASE_URL}}/v1/ops/bom
Content-Type: application/json
 
{
  "code": "BOM-TSHIRT-002",
  "name": "Another T-Shirt BOM",
  "parentMaterialId": 2,   
  "version": "1.0",      
  "lines": [
    {
      "componentMaterialId": 1,
      "quantity": 2,
      "uom": "MTR"
    }
  ]
}

